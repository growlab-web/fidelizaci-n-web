# ===== Básico =====
PORT=3000
# Dirección pública con https (Apple y la cámara del escáner exigen https)
PUBLIC_URL=https://fidelidad.tudominio.pe
# Postgres (Supabase, Neon, Railway...). Vacío = base local en ./data, solo para pruebas
DATABASE_URL=
# Texto largo y aleatorio para firmar las sesiones de los dueños
SESSION_SECRET=
# Clave para entrar a /panel y crear negocios
ADMIN_KEY=
# Segundos mínimos entre sellos a la misma tarjeta antes de pedir confirmación
STAMP_COOLDOWN_SECONDS=30

# ===== Apple Wallet (ver README, sección Apple) =====
APPLE_PASS_TYPE_ID=pass.pe.practik.fidelidad
APPLE_TEAM_ID=
# Archivos PEM convertidos a base64 en una sola línea: base64 -w0 archivo.pem
APPLE_SIGNER_CERT_B64=
APPLE_SIGNER_KEY_B64=
APPLE_SIGNER_KEY_PASSPHRASE=
APPLE_WWDR_B64=

# ===== Google Wallet (ver README, sección Google) =====
GOOGLE_ISSUER_ID=
# JSON de la cuenta de servicio en base64: base64 -w0 cuenta.json
GOOGLE_SERVICE_ACCOUNT_B64=
